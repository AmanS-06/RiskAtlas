{
  "name": "riskatlas-viewer-demo",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone dev harness, unit tests and browser tests for web/src/viewer",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "gen": "node ../scripts/gen_viewer_bands.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
