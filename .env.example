# RiskAtlas environment variables. Every line is commented out: the values shown are the defaults.
#
# Nothing in this repo loads a root-level .env file (there is no python-dotenv). Export these in your shell
# (PowerShell: $env:API_MOCK = "1"), pass them to docker with -e, or set them in your host's dashboard.
# The VITE_* variables are the exception: Vite reads them at build and dev time, from the shell or from
# web/.env.local (see web/.env.example). None of these is a secret.

# ---- API (api/settings.py) -----------------------------------------------------------------------------------
# Serve a fixed example payload instead of running the models (no models loaded; every response says "mock": true).
# API_MOCK=0
# Run one throw-away prediction at start-up so the first user does not wait about 10 s. 0 skips it.
# API_WARMUP=1
# Browser origins allowed to call the API, comma separated, or *. Only needed when the web app is served from a
# different origin than the API. Not needed in single-origin mode or behind the Vite proxy.
# API_CORS_ORIGINS=http://localhost:5173
# Entries in the two LRU caches (/predict/fast, /predict). 0 disables.
# API_CACHE_FAST=512
# API_CACHE_FULL=64

# ---- Single-origin production mode (docs/DEPLOY.md) ----------------------------------------------------------
# One process serves the built web app (web/dist) and the API under /api. Unset: on automatically when
# web/dist/index.html exists. 1 forces it on, 0 forces it off.
# SERVE_WEB=
# Folder of the built web app. Setting it turns serving on.
# WEB_DIST=web/dist
# Port. Render, Railway and similar hosts set it themselves; the Docker image defaults to 7860 (Hugging Face
# Spaces). uvicorn does not read it on its own: the start command passes it (docs/DEPLOY.md).
# PORT=8000

# ---- ML pipeline ---------------------------------------------------------------------------------------------
# Move config/, models/ and reports/ somewhere else (read by pipeline/settings.py, so by the API too).
# RISKATLAS_ROOT=
# Use another ML config file.
# RISKATLAS_ML_CONFIG=
# Let pipeline.evaluate score a NEW set of models on the holdout after it has already been used. Every use is
# recorded in reports/holdout_lock.json. Leave unset.
# RISKATLAS_ALLOW_HOLDOUT_RERUN=1

# ---- Web build and dev server (web/) -------------------------------------------------------------------------
# API location baked into the build. Default /api (same origin). A full URL (https://api.example.org) needs the
# API to allow the web origin in API_CORS_ORIGINS.
# VITE_API_BASE=/api
# Start the app in mock mode (no backend, fixed example data, flagged "MOCK DATA"). ?mock=1 does it per page load.
# VITE_API_MOCK=1
# Where the Vite dev and preview servers proxy /api to (the prefix is stripped). Dev and preview server only.
# VITE_API_PROXY=http://localhost:8000

# ---- Browser tests (web/tests/e2e) ---------------------------------------------------------------------------
# Backend URL for the extra real-API suite, and the path to a chrome binary.
# E2E_REAL_API=http://127.0.0.1:8000
# E2E_CHROMIUM=/path/to/chrome
