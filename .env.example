# Copy to .env and fill in. Never commit .env.

# Return a fixed valid payload from /predict instead of running a model.
# Lets the frontend work before the models exist.
API_MOCK=1

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Frontend -> backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# ML: let pipeline.evaluate score a NEW set of models on the holdout after it has
# already been used. Every use is recorded in reports/holdout_lock.json. Leave unset.
# RISKATLAS_ALLOW_HOLDOUT_RERUN=1
